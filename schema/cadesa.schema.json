{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Cadesa source",
  "description": "Editor autocomplete for *.cadesa.yaml. The CLI's validator is authoritative: it also checks that every reference names a declared token, role, breakpoint or slot.",
  "type": "object",
  "additionalProperties": false,
  "required": [],
  "properties": {
    "version": {
      "const": 1
    },
    "prefix": {
      "type": "string",
      "pattern": "^(?:[a-z][a-z0-9]*-)?$",
      "default": "ca-",
      "description": "Class prefix: .<prefix><component> and .<prefix><component>__<slot>. Use \"\" to keep existing BEM class names."
    },
    "tokens": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "space": {
          "$ref": "#/$defs/spaceTokens"
        },
        "size": {
          "$ref": "#/$defs/sizeTokens"
        },
        "radius": {
          "$ref": "#/$defs/lengthTokens"
        },
        "color": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/ident"
          },
          "additionalProperties": {
            "type": "string",
            "description": "hex, rgb()/rgba(), white, black or transparent"
          }
        },
        "font": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/ident"
          },
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        },
        "paint": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/ident"
          },
          "additionalProperties": {
            "type": "string",
            "pattern": "^(?:(?:repeating-)?(?:linear|radial|conic)-gradient|url|image-set)\\(",
            "description": "background-image value: gradient(s) and/or url()"
          }
        },
        "shadow": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/ident"
          },
          "additionalProperties": {
            "type": "string",
            "minLength": 1,
            "description": "box-shadow value"
          }
        }
      }
    },
    "text": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/ident"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "size",
          "weight",
          "lineHeight",
          "color"
        ],
        "properties": {
          "font": {
            "$ref": "#/$defs/ref",
            "description": "font token"
          },
          "size": {
            "$ref": "#/$defs/length"
          },
          "weight": {
            "oneOf": [
              {
                "type": "integer",
                "minimum": 1,
                "maximum": 1000
              },
              {
                "enum": [
                  "normal",
                  "bold"
                ]
              },
              {
                "type": "string",
                "pattern": "^\\d{1,4}$"
              }
            ]
          },
          "lineHeight": {
            "oneOf": [
              {
                "type": "number",
                "exclusiveMinimum": 0
              },
              {
                "type": "string",
                "pattern": "^(?:\\d*\\.?\\d+(?:px|rem|%)?)$"
              }
            ],
            "description": "ratio (1.5) or a length (\"24px\", \"150%\")"
          },
          "color": {
            "$ref": "#/$defs/ref",
            "description": "color token"
          },
          "decoration": {
            "enum": [
              "none",
              "underline"
            ]
          },
          "letterSpacing": {
            "type": "number",
            "minimum": -0.2,
            "maximum": 1,
            "description": "em"
          },
          "transform": {
            "enum": [
              "uppercase",
              "none"
            ]
          },
          "wrap": {
            "enum": [
              "normal",
              "anywhere",
              "break-word",
              "none"
            ],
            "description": "anywhere: a word too long for a line breaks between characters (and min-content counts single characters); break-word: the same breaking, min-content counts whole words; none: never wraps (white-space: nowrap)"
          }
        }
      }
    },
    "breakpoints": {
      "type": "object",
      "description": "Each breakpoint applies at viewport widths <= its value (desktop-first).",
      "propertyNames": {
        "$ref": "#/$defs/ident"
      },
      "additionalProperties": {
        "$ref": "#/$defs/length"
      }
    },
    "styles": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/ident"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "intent": {
            "type": "string",
            "description": "Design intent. Metadata only; emitted as a CSS comment."
          },
          "slots": {
            "type": "object",
            "propertyNames": {
              "$ref": "#/$defs/ident"
            },
            "additionalProperties": {
              "$ref": "#/$defs/slotProps"
            }
          },
          "when": {
            "type": "object",
            "propertyNames": {
              "$ref": "#/$defs/ident"
            },
            "additionalProperties": {
              "allOf": [
                {
                  "$ref": "#/$defs/rootProps"
                }
              ],
              "properties": {
                "slots": {
                  "type": "object",
                  "additionalProperties": {
                    "$ref": "#/$defs/slotProps"
                  }
                }
              },
              "unevaluatedProperties": false
            }
          }
        },
        "allOf": [
          {
            "$ref": "#/$defs/rootProps"
          }
        ],
        "unevaluatedProperties": false
      }
    },
    "page": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "background": {
          "$ref": "#/$defs/ref",
          "description": "color token behind every component"
        }
      }
    }
  },
  "$defs": {
    "ident": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9]*(?:-[A-Za-z0-9]+)*$"
    },
    "length": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^(?:\\d+(?:\\.\\d+)?|\\.\\d+)(rem|px)?$"
        },
        {
          "type": "number",
          "minimum": 0
        }
      ],
      "description": "rem or px; a plain number is px"
    },
    "ref": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9]*(?:-[A-Za-z0-9]+)*$"
    },
    "lengthTokens": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/ident"
      },
      "additionalProperties": {
        "$ref": "#/$defs/length"
      }
    },
    "boxProps": {
      "type": "object",
      "properties": {
        "layout": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "pattern"
          ],
          "properties": {
            "pattern": {
              "enum": [
                "stack",
                "cluster",
                "grid",
                "layer",
                "flow",
                "table"
              ],
              "description": "flow: block flow; children stack and their vertical margins collapse (no gap or align). table: a table whose children are table parts (part); gap and rowGap are its border spacing"
            },
            "collapse": {
              "type": "boolean",
              "description": "table only: collapsed borders (border-collapse: collapse); default false"
            },
            "fixed": {
              "type": "boolean",
              "description": "table only: column widths from the column elements and the first row (table-layout: fixed); default false"
            },
            "align": {
              "enum": [
                "start",
                "center",
                "end",
                "stretch"
              ],
              "description": "cluster (default center), grid and layer (default stretch); not stack or flow"
            },
            "gap": {
              "$ref": "#/$defs/ref",
              "description": "space token; for a cluster or grid also a percentage size token (of the content width, between columns only)"
            },
            "min": {
              "$ref": "#/$defs/ref",
              "description": "grid: minimum column width; table: its min-width (size token)"
            },
            "justify": {
              "enum": [
                "start",
                "end",
                "center",
                "between",
                "around",
                "evenly"
              ],
              "description": "cluster only: where each line's free space goes (justify-content: flex-start, flex-end, center, space-between, space-around, space-evenly); default start"
            },
            "wrap": {
              "type": "boolean",
              "description": "cluster only: false keeps every item on one line, shrinking them to fit (flex-wrap: nowrap); default true"
            }
          }
        },
        "padding": {
          "description": "space token (every side), or { block, inline } and/or { top, right, bottom, left } space tokens (a side beats its axis; a missing side is 0); none: in a breakpoint override, removes the value a wider state set",
          "oneOf": [
            {
              "$ref": "#/$defs/ref"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "minProperties": 1,
              "properties": {
                "block": {
                  "$ref": "#/$defs/ref"
                },
                "inline": {
                  "$ref": "#/$defs/ref"
                },
                "top": {
                  "$ref": "#/$defs/ref"
                },
                "right": {
                  "$ref": "#/$defs/ref"
                },
                "bottom": {
                  "$ref": "#/$defs/ref"
                },
                "left": {
                  "$ref": "#/$defs/ref"
                }
              }
            }
          ]
        },
        "margin": {
          "description": "space token (every side; may be negative), or { block, inline } and/or { top, right, bottom, left } (a side beats its axis; a missing side is 0). left, right and inline may be auto: the free space of a cluster's line, or of a block-flow cell, goes there (two center the box). Collapses in a flow; adds to the outer size in a stack, cluster, grid or layer; none: in a breakpoint override, removes the value a wider state set",
          "oneOf": [
            {
              "$ref": "#/$defs/ref"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "minProperties": 1,
              "properties": {
                "block": {
                  "$ref": "#/$defs/ref"
                },
                "top": {
                  "$ref": "#/$defs/ref"
                },
                "bottom": {
                  "$ref": "#/$defs/ref"
                },
                "inline": {
                  "oneOf": [
                    {
                      "$ref": "#/$defs/ref"
                    },
                    {
                      "const": "auto"
                    }
                  ]
                },
                "left": {
                  "oneOf": [
                    {
                      "$ref": "#/$defs/ref"
                    },
                    {
                      "const": "auto"
                    }
                  ]
                },
                "right": {
                  "oneOf": [
                    {
                      "$ref": "#/$defs/ref"
                    },
                    {
                      "const": "auto"
                    }
                  ]
                }
              }
            }
          ]
        },
        "background": {
          "$ref": "#/$defs/ref",
          "description": "color token; none: in a breakpoint override, removes the value a wider state set"
        },
        "border": {
          "description": "color token (1px solid on every side), or { color, width, top, right, bottom, left } with space tokens as widths (width every side, a side beats it, a missing side is 0; drawn at whole pixels as Chromium does); none: in a breakpoint override, removes the value a wider state set",
          "oneOf": [
            {
              "$ref": "#/$defs/ref"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "color"
              ],
              "properties": {
                "color": {
                  "$ref": "#/$defs/ref"
                },
                "width": {
                  "$ref": "#/$defs/ref"
                },
                "top": {
                  "$ref": "#/$defs/ref"
                },
                "right": {
                  "$ref": "#/$defs/ref"
                },
                "bottom": {
                  "$ref": "#/$defs/ref"
                },
                "left": {
                  "$ref": "#/$defs/ref"
                }
              }
            }
          ]
        },
        "radius": {
          "$ref": "#/$defs/ref",
          "description": "radius token; none: in a breakpoint override, removes the value a wider state set"
        },
        "width": {
          "$ref": "#/$defs/ref",
          "description": "size token (a length or a percentage of the parent), fill (stretch inside a stack), or fit (as wide as its content, at most the parent: width: fit-content); none: in a breakpoint override, removes the value a wider state set"
        },
        "height": {
          "$ref": "#/$defs/ref",
          "description": "size token; a percentage is of the parent's content height once that is definite (stretched in a cluster or grid row, or set), auto until then; none: in a breakpoint override, removes the value a wider state set"
        },
        "text": {
          "$ref": "#/$defs/ref",
          "description": "text role"
        },
        "textAlign": {
          "enum": [
            "start",
            "center",
            "end"
          ]
        },
        "maxWidth": {
          "$ref": "#/$defs/ref",
          "description": "size token (a length or a percentage); caps the width and centers the box; none: in a breakpoint override, removes the value a wider state set"
        },
        "measure": {
          "$ref": "#/$defs/ref",
          "description": "size token (a length or a percentage); caps the width, stays left-aligned; none: in a breakpoint override, removes the value a wider state set"
        },
        "aspect": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^\\s*[\\d.]+\\s*[:/]\\s*[\\d.]+\\s*$"
            },
            {
              "type": "number",
              "exclusiveMinimum": 0
            },
            {
              "const": "none"
            }
          ],
          "description": "width:height, e.g. \"16:9\"; none: in a breakpoint override, removes the value a wider state set"
        },
        "fit": {
          "enum": [
            "cover",
            "contain"
          ]
        },
        "overflow": {
          "oneOf": [
            {
              "enum": ["visible", "hidden", "clip", "auto", "scroll"]
            },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "x": { "enum": ["visible", "hidden", "clip", "auto", "scroll"] },
                "y": { "enum": ["visible", "hidden", "clip", "auto", "scroll"] }
              }
            }
          ],
          "description": "content that doesn't fit scrolls (auto, scroll) or is cut off (hidden, clip) instead of spilling out; one keyword for both axes or { x, y }. Anything but visible and clip also stops margins collapsing through the box and lets it shrink below its content in a cluster"
        },
        "contain": {
          "type": "string",
          "pattern": "^\\s*(none|content|strict|((size|inline-size|layout|style|paint)(\\s+|$))+)\\s*$",
          "description": "CSS containment: layout or paint makes the box an independent formatting context (margins don't collapse through it) and the containing block of its absolute and fixed descendants (paint also clips); size sizes it as if empty (inline-size: its widths only); style changes nothing. content is layout paint style, strict adds size; none: in a breakpoint override, no containment"
        },
        "part": {
          "type": "string",
          "pattern": "^\\s*(caption(\\s+(top|bottom))?|column|column-group|header|body|footer|row|cell(\\s+(baseline|top|middle|bottom))?)\\s*$",
          "description": "a part of a table: caption (top or bottom), column, column-group, header, body, footer (row groups), row, or cell with where its content sits in its row (baseline, the default; top, middle, bottom). Cells span the columns and rows of their colspan and rowspan attributes"
        },
        "backdrop": {
          "$ref": "#/$defs/ref",
          "description": "paint token; none: in a breakpoint override, removes the value a wider state set"
        },
        "shadow": {
          "$ref": "#/$defs/ref",
          "description": "shadow token; none: in a breakpoint override, removes the value a wider state set"
        },
        "grow": {
          "description": "in a cluster or stack: takes a share of the line's free space (or the stack's extra height) in proportion to the factor (flex-grow). A number grows from the box's own size; { factor, basis: zero } shares the space from nothing (equal shares: flex: 1 0 0), never below the content's min-content width; none: in a breakpoint override, removes the value a wider state set",
          "oneOf": [
            {
              "type": "number",
              "exclusiveMinimum": 0
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "factor"
              ],
              "properties": {
                "factor": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "basis": {
                  "enum": [
                    "zero",
                    "content"
                  ]
                }
              }
            },
            {
              "const": "none"
            }
          ]
        }
      }
    },
    "rootProps": {
      "allOf": [
        {
          "$ref": "#/$defs/boxProps"
        }
      ]
    },
    "slotProps": {
      "allOf": [
        {
          "$ref": "#/$defs/boxProps"
        }
      ],
      "unevaluatedProperties": false
    },
    "sizeTokens": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/ident"
      },
      "additionalProperties": {
        "oneOf": [
          {
            "$ref": "#/$defs/length"
          },
          {
            "type": "string",
            "pattern": "^\\s*(?:\\d+(?:\\.\\d+)?|\\.\\d+)%\\s*$",
            "description": "a percentage of the parent's content width (width, maxWidth and measure only)"
          },
          {
            "type": "string",
            "pattern": "^\\s*(?:calc|min|max|clamp)\\(.*%.*\\)\\s*$",
            "description": "calc(), min(), max() or clamp() with percentages of the parent's content width, e.g. \"min(440px, 100%)\" (width, maxWidth and measure only)"
          }
        ]
      }
    },
    "signedLength": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^-?(?:\\d+(?:\\.\\d+)?|\\.\\d+)(rem|px)?$"
        },
        {
          "type": "number"
        }
      ],
      "description": "rem or px; a plain number is px; negative only for margins"
    },
    "spaceTokens": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/ident"
      },
      "additionalProperties": {
        "$ref": "#/$defs/signedLength"
      },
      "description": "Spacing. A negative token is only for margins (it pulls the box outward); padding, gaps and border widths must be 0 or more."
    }
  }
}
