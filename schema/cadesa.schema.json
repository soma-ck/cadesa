{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Cadesa source",
  "description": "Editor autocomplete for *.cadesa.yaml. The CLI's validator is authoritative: it also checks that every reference names a declared token, role, breakpoint or slot.",
  "type": "object",
  "additionalProperties": false,
  "required": [],
  "properties": {
    "version": {
      "const": 1
    },
    "prefix": {
      "type": "string",
      "pattern": "^(?:[a-z][a-z0-9]*-)?$",
      "default": "ca-",
      "description": "Class prefix: .<prefix><component> and .<prefix><component>__<slot>. Use \"\" to keep existing BEM class names."
    },
    "tokens": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "space": {
          "$ref": "#/$defs/lengthTokens"
        },
        "size": {
          "$ref": "#/$defs/sizeTokens"
        },
        "radius": {
          "$ref": "#/$defs/lengthTokens"
        },
        "color": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/ident"
          },
          "additionalProperties": {
            "type": "string",
            "description": "hex, rgb()/rgba(), white, black or transparent"
          }
        },
        "font": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/ident"
          },
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        },
        "paint": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/ident"
          },
          "additionalProperties": {
            "type": "string",
            "pattern": "^(?:(?:repeating-)?(?:linear|radial|conic)-gradient|url|image-set)\\(",
            "description": "background-image value: gradient(s) and/or url()"
          }
        },
        "shadow": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/ident"
          },
          "additionalProperties": {
            "type": "string",
            "minLength": 1,
            "description": "box-shadow value"
          }
        }
      }
    },
    "text": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/ident"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "size",
          "weight",
          "lineHeight",
          "color"
        ],
        "properties": {
          "font": {
            "$ref": "#/$defs/ref",
            "description": "font token"
          },
          "size": {
            "$ref": "#/$defs/length"
          },
          "weight": {
            "oneOf": [
              {
                "type": "integer",
                "minimum": 1,
                "maximum": 1000
              },
              {
                "enum": [
                  "normal",
                  "bold"
                ]
              },
              {
                "type": "string",
                "pattern": "^\\d{1,4}$"
              }
            ]
          },
          "lineHeight": {
            "oneOf": [
              {
                "type": "number",
                "exclusiveMinimum": 0
              },
              {
                "type": "string",
                "pattern": "^(?:\\d*\\.?\\d+(?:px|rem|%)?)$"
              }
            ],
            "description": "ratio (1.5) or a length (\"24px\", \"150%\")"
          },
          "color": {
            "$ref": "#/$defs/ref",
            "description": "color token"
          },
          "decoration": {
            "enum": [
              "none",
              "underline"
            ]
          },
          "letterSpacing": {
            "type": "number",
            "minimum": -0.2,
            "maximum": 1,
            "description": "em"
          },
          "transform": {
            "enum": [
              "uppercase",
              "none"
            ]
          }
        }
      }
    },
    "breakpoints": {
      "type": "object",
      "description": "Each breakpoint applies at viewport widths <= its value (desktop-first).",
      "propertyNames": {
        "$ref": "#/$defs/ident"
      },
      "additionalProperties": {
        "$ref": "#/$defs/length"
      }
    },
    "styles": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/ident"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "intent": {
            "type": "string",
            "description": "Design intent. Metadata only; emitted as a CSS comment."
          },
          "slots": {
            "type": "object",
            "propertyNames": {
              "$ref": "#/$defs/ident"
            },
            "additionalProperties": {
              "$ref": "#/$defs/slotProps"
            }
          },
          "when": {
            "type": "object",
            "propertyNames": {
              "$ref": "#/$defs/ident"
            },
            "additionalProperties": {
              "allOf": [
                {
                  "$ref": "#/$defs/rootProps"
                }
              ],
              "properties": {
                "slots": {
                  "type": "object",
                  "additionalProperties": {
                    "$ref": "#/$defs/slotProps"
                  }
                }
              },
              "unevaluatedProperties": false
            }
          }
        },
        "allOf": [
          {
            "$ref": "#/$defs/rootProps"
          }
        ],
        "unevaluatedProperties": false
      }
    },
    "page": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "background": {
          "$ref": "#/$defs/ref",
          "description": "color token behind every component"
        }
      }
    }
  },
  "$defs": {
    "ident": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9]*(?:-[A-Za-z0-9]+)*$"
    },
    "length": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^(?:\\d+(?:\\.\\d+)?|\\.\\d+)(rem|px)?$"
        },
        {
          "type": "number",
          "minimum": 0
        }
      ],
      "description": "rem or px; a plain number is px"
    },
    "ref": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9]*(?:-[A-Za-z0-9]+)*$"
    },
    "lengthTokens": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/ident"
      },
      "additionalProperties": {
        "$ref": "#/$defs/length"
      }
    },
    "boxProps": {
      "type": "object",
      "properties": {
        "layout": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "pattern"
          ],
          "properties": {
            "pattern": {
              "enum": [
                "stack",
                "cluster",
                "grid",
                "layer",
                "flow"
              ],
              "description": "flow: block flow; children stack and their vertical margins collapse (no gap or align)"
            },
            "align": {
              "enum": [
                "start",
                "center",
                "end",
                "stretch"
              ],
              "description": "cluster (default center), grid and layer (default stretch); not stack or flow"
            },
            "gap": {
              "$ref": "#/$defs/ref",
              "description": "space token"
            },
            "min": {
              "$ref": "#/$defs/ref",
              "description": "grid only: minimum column width (size token)"
            }
          }
        },
        "padding": {
          "description": "space token, or { block, inline } space tokens (a missing axis is 0)",
          "oneOf": [
            {
              "$ref": "#/$defs/ref"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "minProperties": 1,
              "properties": {
                "block": {
                  "$ref": "#/$defs/ref"
                },
                "inline": {
                  "$ref": "#/$defs/ref"
                }
              }
            }
          ]
        },
        "margin": {
          "description": "space token (every side), or { block, inline } and/or { top, right, bottom, left } space tokens (a side beats its axis; a missing side is 0). Collapses in a flow; adds to the outer size in a stack, cluster, grid or layer",
          "oneOf": [
            {
              "$ref": "#/$defs/ref"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "minProperties": 1,
              "properties": {
                "block": {
                  "$ref": "#/$defs/ref"
                },
                "inline": {
                  "$ref": "#/$defs/ref"
                },
                "top": {
                  "$ref": "#/$defs/ref"
                },
                "right": {
                  "$ref": "#/$defs/ref"
                },
                "bottom": {
                  "$ref": "#/$defs/ref"
                },
                "left": {
                  "$ref": "#/$defs/ref"
                }
              }
            }
          ]
        },
        "background": {
          "$ref": "#/$defs/ref",
          "description": "color token"
        },
        "border": {
          "$ref": "#/$defs/ref",
          "description": "color token (1px solid)"
        },
        "radius": {
          "$ref": "#/$defs/ref",
          "description": "radius token"
        },
        "width": {
          "$ref": "#/$defs/ref",
          "description": "size token (a length or a percentage of the parent), or fill (stretch inside a stack)"
        },
        "height": {
          "$ref": "#/$defs/ref",
          "description": "size token (a length, not a percentage)"
        },
        "text": {
          "$ref": "#/$defs/ref",
          "description": "text role"
        },
        "textAlign": {
          "enum": [
            "start",
            "center",
            "end"
          ]
        },
        "maxWidth": {
          "$ref": "#/$defs/ref",
          "description": "size token (a length or a percentage); caps the width and centers the box"
        },
        "measure": {
          "$ref": "#/$defs/ref",
          "description": "size token (a length or a percentage); caps the width, stays left-aligned"
        },
        "aspect": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^\\s*[\\d.]+\\s*[:/]\\s*[\\d.]+\\s*$"
            },
            {
              "type": "number",
              "exclusiveMinimum": 0
            }
          ],
          "description": "width:height, e.g. \"16:9\""
        },
        "fit": {
          "enum": [
            "cover",
            "contain"
          ]
        },
        "backdrop": {
          "$ref": "#/$defs/ref",
          "description": "paint token"
        },
        "shadow": {
          "$ref": "#/$defs/ref",
          "description": "shadow token"
        }
      }
    },
    "rootProps": {
      "allOf": [
        {
          "$ref": "#/$defs/boxProps"
        }
      ]
    },
    "slotProps": {
      "allOf": [
        {
          "$ref": "#/$defs/boxProps"
        }
      ],
      "unevaluatedProperties": false
    },
    "sizeTokens": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/ident"
      },
      "additionalProperties": {
        "oneOf": [
          {
            "$ref": "#/$defs/length"
          },
          {
            "type": "string",
            "pattern": "^\\s*(?:\\d+(?:\\.\\d+)?|\\.\\d+)%\\s*$",
            "description": "a percentage of the parent's content width (width, maxWidth and measure only)"
          }
        ]
      }
    }
  }
}
