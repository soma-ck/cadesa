{
  "name": "cascadio",
  "version": "0.1.0",
  "description": "Predict what a style edit will do before you make it. Cascadio computes layout without a browser and ships plain CSS.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "cascadio": "dist/cli.js"
  },
  "files": [
    "lib",
    "schema",
    "fonts",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "cascadio": "tsx src/cli.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build:ts": "tsc -p tsconfig.json",
    "prepublishOnly": "npm run typecheck && npm test && npm run build:ts",
    "conformance": "tsx scripts/conformance.ts",
    "demo": "tsx src/cli.ts build settings.cascade.yaml --out dist/settings.css && tsx src/cli.ts whatif fixtures/settings.html --source settings.cascade.yaml --widths 390,1280 --set styles.settings-panel.when.narrow.padding=panel",
    "conformance:sweep": "tsx scripts/conformance.ts --fixtures fixtures/settings-long.html --widths $(seq -s, 260 3 1000) --out artifacts/sweep",
    "metrics": "tsx scripts/gen-metrics.ts",
    "conformance:lift": "tsx scripts/conformance.ts --lift fixtures/legacy.css --fixtures fixtures/legacy.html --out artifacts/legacy"
  },
  "keywords": [
    "css",
    "ai",
    "agents",
    "layout",
    "design-tokens",
    "responsive",
    "compiler"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "parse5": "8.1.1",
    "postcss": "8.5.32",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "playwright": "1.65.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  },
  "peerDependencies": {
    "playwright": ">=1.40"
  },
  "peerDependenciesMeta": {
    "playwright": {
      "optional": true
    }
  }
}
